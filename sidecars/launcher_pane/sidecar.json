{
  "title": "文件助手 (File Launcher)",
  "command": "python",
  "args": ["main.py"],
  "restart_policy": "always",
  "has_web_ui": true,
  "ui_config": {
    "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
    "file_extensions": [".docx", ".doc", ".pptx", ".ppt", ".xlsx", ".xls", ".pdf", ".md"]
  }
}
